pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- following along with 
-- lazy devs tutorial series here
-- https://youtube.com/playlist?list=plea8cjcua_p3ll7j1q9b6pjua0a-96uus
function _init()
 _upd=update_game
 _drw=draw_game
 
 startgame()
end

function _update()
	_upd()
end

function _draw()
	_drw()
end

function startgame()
 pos={x=0,y=3}
 
end
-->8
--updates
function update_game()
 if btnp(⬅️) then
 	pos.x-=1
 end
 if btnp(➡️) then
 	pos.x+=1
 end
 if btnp(⬆️) then
 	pos.y-=1
 end
 if btnp(⬇️) then
 	pos.y+=1
 end
end
-->8
--draws
function draw_game()
 cls()
 map()
 
 palt(0,false)
 spr(1,8*pos.x,8*pos.y)
end
