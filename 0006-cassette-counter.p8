pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- cassette counter
-- by peter gagliardi (@ptrgags)

-- inspired by a mix of:
-- 
-- - my rew/ffwd album cover: https://ptrgags.dev/#/album/rewind-and-ffwd

function _init()
	counter=0
	count_max=1023
	
	min_r=12
	max_r=32
	
	r_left=max_r
	r_right=min_r
	
	counter=0
	
	spd_stop=0
	spd_slow=1
	spd_fast=32
	speed=spd_slow
end

function _update()
	counter+=speed
	counter=mid(
		counter,0,count_max)
	percent=counter/count_max
	
	r_left=min_r+(1-percent)*(max_r-min_r)
	r_right=min_r+percent*(max_r-min_r)
end

function _draw()
 cls(4)
 
 --reels of tape
	circfill(32,64,r_left,5)
	circfill(96,64,r_right,5)

 --line of tape between reels
 --(approx)
 line(32-r_left,64,0,128-16,5)
 line(95+r_right,64,127,128-16,5)
 line(8,128-8,128-8,128-8,5)

	--decorate center of reels
	circfill(32,64,min_r,7)
	circfill(96,64,min_r,7)

 --tape guides
 circfill(8,128-16,8,7)
 circfill(128-8,128-16,8,7)
 pset(8,128-16,0)
 pset(128-8,128-16,0)
 
 print(counter,0,0,10)
end

