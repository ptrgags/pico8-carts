pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
obj={
	[4]="food",
	[5]="squid",
	[6]="light",
	[7]="chest",
	[10]="plankson",
}

function _init()
	win=false
	fish=make_fish(2,2)
end

function _update()
 if not win then
		update_fish(fish)
	end
end

function _draw()
	cls(1)
	map()
	draw_fish(fish)
	draw_ui(fish)
	
	if win then
		rectfill(32,32,96,48,10)
		print("you win!",48,40,2)
	end
end
-->8
-- fish

function make_fish(x,y)
	return {
		x=x,
		y=y,
		im=1,
		food=0,
		light=0,
	}
end

function update_fish(f)
	local dx=0
	local dy=0
 if(btnp(⬆️)) dy=-1
 if(btnp(⬇️)) dy=1
 if dy==0 then -- no diag
	 if(btnp(⬅️)) dx=-1
	 if(btnp(➡️)) dx=1
 end
 
 local tx=f.x+dx
 local ty=f.y+dy
 
 local target=mget(tx,ty)
 
 --walls
 local wall=fget(target,0)
 
 --pushables
 local push=fget(target,2)
 if push then
  -- see where chest would be
  -- moved to
 	local cx=tx+dx
 	local cy=ty+dy
 	
 	if mget(cx,cy)==0 then
 		mset(tx,ty,0)
 		mset(cx,cy,target)
 		wall=false
 	end
 end
 
 if wall 
 and obj[target]=="squid" then
 	if f.light>0 then
 		f.light-=1
 		mset(tx,ty,0)
 		wall=false
 	end
 end
 
 -- collectibles
 if fget(target,1) then
 	mset(tx,ty,0)
 	
 	-- look up tile type
 	local oname=obj[target]
 	if oname=="plankson" then
 		win=true
 		f.im=11
 		return
 	end
 	
 	if f[oname] then
 		f[oname]+=1
 	end
 end
 
 
 if not wall then
	 f.x+=dx
	 f.y+=dy
 end
end

function draw_fish(f)
	spr(f.im,8*f.x,8*f.y)
end
-->8
--ui

function draw_ui(f)
	local x=0
	local y=121
	spr(4,x,y-1)
	print(f.food,x+8,y,6)
	
	spr(6,64,y-1)
	print(f.light,64+8,y,6)
end
