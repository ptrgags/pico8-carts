pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 x=64
 y=64
 r=8
 c=7
 speed=2
end

function _update60()
 --movement
	if btn(0) then
	 x=x-speed
	end
	if btn(1) then
	 x=x+speed
	end
	if btn(2) then
	 y=y-speed
	end
	if btn(3) then
	 y=y+speed
	end
	
	--clamp
	x=mid(x,0,128-r)
	y=mid(y,0,128-r)
end

function _draw()
 cls()
 rectfill(0,0,127,127,5)

 
 spr(1,x,y)
 --circ(x,y,r,c)
end

