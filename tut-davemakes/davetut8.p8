pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
obj={
	[4]="food",
	[5]="squid",
	[6]="light",
	[7]="chest",
	[10]="plankson",
}

lvl_w=16 --tiles
lvl_h=15 --save room for ui

--easing
function ease(a,b,t)
 t=1-(1-t)^3
 return (1-t)*a+t*b
end

function _init()
	win=false
	fish=make_fish(2,2)
	
	undo=undo_new()
	
	cam={
	 x=0,
	 y=0,
	}
end

function _update()
 if not win then
		update_fish(fish)
	end
	
	-- \ is like // in python
	if cam.x\lvl_w!=fish.x\lvl_w
	or cam.y\lvl_h!=fish.y\lvl_h
	then
		//quantize based on multiples
		// of level size
		--cam.x=fish.x\lvl_w*lvl_w
		--cam.y=fish.y\lvl_h*lvl_h
		
		-- level transition
		local srcx=cam.x
		local srcy=cam.y
		local dstx=fish.x\lvl_w*lvl_w
		local dsty=fish.y\lvl_h*lvl_h
		for i=0,1,1/16 do
			cam.x=ease(srcx,dstx,i)
			cam.y=ease(srcy,dsty,i)
			_draw()
			flip()
		end
	end
end

function _draw()
	cls(1)
	--the 0.5 is so the camera
	--does round() instead of
	--floor()
	camera(8*cam.x+0.5,8*cam.y+0.5)
	
	
	map()
	draw_fish(fish)
	
	camera()
	rectfill(0,120,128,128,0)
	draw_ui(fish)
	
	if win then
		rectfill(32,32,96,48,10)
		print("you win!",48,40,2)
	end
end
-->8
--fish

function make_fish(x,y)
	return {
		x=x,
		y=y,
		im=1,
		food=0,
		light=0,
	}
end

function update_fish(f)
	local dx=0
	local dy=0
 if(btnp(⬅️)) dx=-1
 if(btnp(➡️)) dx=1
 if(btnp(⬆️)) dy=-1
 if(btnp(⬇️)) dy=1

 
 -- avoid diagonals
 print(dx,0,0)
 if abs(dx)+abs(dy)==1 then
 	fish_move(f,dx,dy)
 	return
 end
 
 if btnp(❎) then
 	undo:back()
 end
end

function fish_move(f,dx,dy)
	undo.arm=true
 
 local tx=f.x+dx
 local ty=f.y+dy
 
 local target=mget(tx,ty)
 
 --walls
 local wall=fget(target,0)
 
 --pushables
 local push=fget(target,2)
 if push then
  -- see where chest would be
  -- moved to
 	local cx=tx+dx
 	local cy=ty+dy
 	
 	if mget(cx,cy)==0 then
 		undo:rec("map",{tx,ty})
 		undo:rec("map",{cx,cy})
 	
 		mset(tx,ty,0)
 		mset(cx,cy,target)
 		wall=false
 	end
 end
 
 if wall 
 and obj[target]=="squid" then
 	if f.light>0 then
 	
 	 undo:rec(f,"light")
 	 undo:rec("map",{tx,ty})
 	 
 		f.light-=1
 		mset(tx,ty,0)
 		wall=false
 	end
 end
 
 -- collectibles
 if fget(target,1) then
 	undo:rec("map",{tx,ty})
 	mset(tx,ty,0)
 	
 	-- look up tile type
 	local oname=obj[target]
 	if oname=="plankson" then
 		win=true
 		undo:rec(f,"im")
 		f.im=11
 		return
 	end
 	
 	if f[oname] then
 		undo:rec(f,oname)
 		f[oname]+=1
 	end
 end
 
 
 if not wall then
 	undo:rec(f,"x")
 	undo:rec(f,"y")
	 f.x+=dx
	 f.y+=dy
 end
end

function draw_fish(f)
	spr(f.im,8*f.x,8*f.y)
end
-->8
--ui

function draw_ui(f)
	local x=0
	local y=121
	spr(4,x,y-1)
	print(f.food,x+8,y,6)
	
	spr(6,64,y-1)
	print(f.light,64+8,y,6)
	
	--debug
	x+=15
	print(undo.step.." "..undo.start,x,y,8)
end
-->8
--undo history

function undo_new()
	return {
		step=0, --record position
		past={}, --recorded hist
		arm=true, --arm for recording
		--ring buffer
		len=256, --history size
		start=0, --history start
		
		rec=undo_rec,
		advance=undo_advance,
		back=undo_back,
	}
end

--o is the object effected
--key is the id of the object
function undo_rec(u,o,key)
 u:advance()
 
	local snapshot=u.past[u.step]
	
	if o=="map" then
		add(
			snapshot,
			--key are {x,y} tile coords
			{o,key,mget(key[1],key[2])}
		)
	else --table
		add(
			snapshot,
			--object, key, value
			{o,key,o[key]}
		)
	end
end

function undo_advance(u)
	if(not u.arm) return
	
	u.arm=false

	u.step=(u.step+1)%u.len
	if u.step==u.start then
	 u.start=(u.start+1)%u.len
	end
	
	u.past[u.step]={}
end

function undo_back(u)
	--if no history
	if not u.past[u.step] then
		return --return early
	end
	
	local snap=u.past[u.step]
		
 for i=#snap,1,-1 do
 	local o,key,val=unpack(snap[i])
 	
 	if o=="map" then
 		mset(key[1],key[2],val)
 	else
 		o[key]=value
 	end
 end
 
 --remove this snapshot
 u.past[u.step]=nil

 if u.step!=u.start then
 	u.step=(u.step-1)%u.len
 end
end
