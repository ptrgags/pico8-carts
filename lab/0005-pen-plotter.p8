pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pen plotter shooter
-- by peter gagliardi @ptrgags

-- inspired by davemakes'
-- second pico8 tutorial
-- https://youtu.be/c1e5wiqdhdc

function _init()
 --xy-arm like a pen plotter
	arm=make_arm()
	
	--pattern for background
	--0100
	--1000
	--0010
	--0001
	pat=0b0100100000100001
	
	bullets={}
end

function _update()
 -- move the bullets
	for b in all(bullets) do
		b.x+=b.dx
		b.y+=b.dy
		b.life-=1
		
		-- clear old bullets
		if b.life<=0 then
			del(bullets,b)
		end
	end

 -- d-pad moves the arm
	if (btn(⬅️)) arm.x-=arm.s
	if (btn(➡️)) arm.x+=arm.s
	if (btn(⬆️)) arm.y-=arm.s
	if (btn(⬇️)) arm.y+=arm.s
	
	-- stay in bounds
	arm.x=mid(arm.x,0,128-16)
	arm.y=mid(arm.y,0,128-16)
	
	-- x button shoots
	if btnp(❎) then
		add(
			bullets,
			make_bullet(arm.x+8,arm.y+8)
		)
		-- the apparatus lights up
		-- red when shooting as
		-- further visual feedback
  arm.spr_idx=8
	else
	 -- when not shooting,
	 -- the light is orange
		arm.spr_idx=6
	end
end


function _draw()
 cls()
 
 -- draw background
 fillp(pat)
 rectfill(0,0,127,127, 1)
 
 -- x marks the spot
 spr(1,64-4,64-4)
 
 -- pew pew
 for b in all(bullets) do
 	spr(5,b.x-4,b.y-4)
 end
 
 -- draw the two metal arms
 -- that the apparatus is
 -- mounted on
 for i=0,15 do
	 spr(3,i*8,arm.y+4)
	 spr(4,arm.x+4,i*8)
 end
 
 -- draw the shooting
 -- apparatus. it's red when
 -- it fires, orange otherwise.
 fillp()
	spr(
		arm.spr_idx,
		arm.x,
		arm.y,
		2,
		2
	)
end
-->8
-- arm and bullet structs

function make_arm()
 return {
  x=16,
  y=16,
  --speed
  s=2,
  spr_idx=6
 }
end

function make_bullet(x,y)
 -- compute direction
 -- towards center
 local dx=64-x
 local dy=64-y
 
 -- normalize the length
 local r=sqrt(dx*dx+dy*dy)
 if r==0 then
  -- can't divide by zero
  -- so pick a direction
  dx=1
  dy=0
 else 
 	dx/=r
 	dy/=r
 end
 
 local speed=4
	return {
 	x=x,
 	y=y,
 	-- scale up to the desired
 	-- speed
 	dx=speed*dx,
 	dy=speed*dy,
 	-- after this many frames,
 	-- a bullet will disappear
 	life=60,
 }
end
