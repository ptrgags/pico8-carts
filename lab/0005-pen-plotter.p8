pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	arm=make_arm()
	
	--0100
	--1000
	--0010
	--0001
	pat=0b0100100000100001
	
	bullets={}
end

function _update()
	for b in all(bullets) do
		b.x+=b.dx
		b.y+=b.dy
		b.life-=1
		
		if b.life<=0 then
			del(bullets,b)
		end
	end

	if (btn(⬅️)) arm.x-=arm.s
	if (btn(➡️)) arm.x+=arm.s
	if (btn(⬆️)) arm.y-=arm.s
	if (btn(⬇️)) arm.y+=arm.s
	
	arm.x=mid(arm.x,0,128-16)
	arm.y=mid(arm.y,0,128-16)
	
	if btnp(❎) do
		add(
			bullets,
			make_bullet(arm.x+8,arm.y+8)
		)
	end
end


function _draw()
 cls()
 
 fillp(pat)
 rectfill(0,0,127,127, 1)
 
 --fuck this spot in particular
 spr(1,64-4,64-4)
 
 for b in all(bullets) do
 	spr(5,b.x-4,b.y-4)
 end
 

 
 for i=0,15 do
 spr(3,i*8,arm.y+4)
 spr(4,arm.x+4,i*8)
 end
 
 fillp()
	spr(6,arm.x,arm.y,2,2)
end
-->8
function make_arm()
 return {
  x=16,
  y=16,
  --speed
  s=2
 }
end

function make_bullet(x,y)
 -- compute direction
 -- to center
 local dx=64-x
 local dy=64-y
 local r=sqrt(dx*dx+dy*dy)
 
 if r==0 then
  dx=1
  dy=0
 else 
 	dx/=r
 	dy/=r
 end
 
 local speed=4
 
	return {
 	x=x,
 	y=y,
 	dx=speed*dx,
 	dy=speed*dy,
 	life=60,
 }
end
