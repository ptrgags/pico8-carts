pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- braid tiling
-- by peter gagliardi (@ptrgags)
-- 2026-08-15

function _init()
 -- position in tiles
	cur={x=0,y=0}
	valid=true
end

function _update()
	if (btnp(⬅️)) cur.x-=1
	if (btnp(➡️)) cur.x+=1
	if (btnp(⬆️)) cur.y-=1
	if (btnp(⬇️)) cur.y+=1
	
	cur.x=mid(cur.x,0,14)
	cur.y=mid(cur.y,0,15)
	
	tile1=mget(cur.x,cur.y)
	tile2=mget(cur.x+1,cur.y)
	valid=(
		(tile1==1 and tile2==1) or
		(tile1==2 and tile2==3)
	)
	
	if btnp(❎) and valid then
		if tile1==1 then
		 -- cross ropes
			mset(cur.x,cur.y,2)
			mset(cur.x+1,cur.y,3)
			sfx(2)
		else
		 -- uncross ropes
			mset(cur.x,cur.y,1)
			mset(cur.x+1,cur.y,1)
			sfx(3)
		end
	elseif btnp(❎) then
		sfx(0)
	end
end

function _draw()
	cls(1)
	map()
	
	if valid then
		spr(6,8*cur.x,8*cur.y,2,1)
	else
		spr(4,8*cur.x,8*cur.y,2,1)
	end
end
