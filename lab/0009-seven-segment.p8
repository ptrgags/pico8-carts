pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--seven segment
--by peter gagliardi (@ptrgags)
--2026-08

function _init()
	cls()

	number=0
end

function _update()
	if (btnp(⬆️)) number+=1
	if (btnp(⬇️)) number-=1
	
	number%=16
end

function _draw()
 map()
	
	-- little decimal number
	local tens=flr(number/10)
	local ones=number%10
	spr(find_small(tens),1*8,12*8)
	spr(find_small(ones),2*8,12*8)
	
	-- big lcd digit
	spr(
		find_lcd(number),
		64-8,
		64+3*8,
		2,
		4
	)

	--wires
	--[[
	b0=number&1
	b1=(number>>1)&1
	b2=(number>>2)&1
	b3=(number>>3)&1
	line(
		64,0,64,12,wire_color(b3))
	line(
		64+2,0,64+2,12,wire_color(b2))
	line(
		64+4,0,64+4,12,wire_color(b1))
	line(
		64+6,0,64+6,12,wire_color(b0))
 ]]
		
	draw_binary_wires(number)
	draw_segment_wires(number)
end
-->8
--digits
function find_lcd(digit)
	if digit < 5 then
		return 1+2*digit
	end
	
	if digit < 10 then
		return 64+2*(digit-5) 
	end
	
	--a thru f
	return 128+2*(digit-10)
end

function find_small(digit)
	return 192+digit
end
-->8
--wires

r_wire=1

function to_bits(n)
	return {
		n&1,
		n>>1&1,
		n>>2&1,
		n>>3&1,
	}
end



-- map of digit -> segments
-- segments = [a,b,c,d,e,f,g]
lcd_encoder={
	[0x0]={1,1,1,1,1,1,0},
	[0x1]={0,1,1,0,0,0,0},
	[0x2]={1,1,0,1,1,0,1},
	[0x3]={1,1,1,1,0,0,1},
	[0x4]={0,1,1,0,0,1,1},
	[0x5]={1,0,1,1,0,1,1},
	[0x6]={1,0,1,1,1,1,1},
	[0x7]={1,1,1,0,0,0,0},
	[0x8]={1,1,1,1,1,1,1},
	[0x9]={1,1,1,1,0,1,1},
	[0xa]={1,1,1,0,1,1,1},
	[0xb]={0,0,1,1,1,1,1},
	[0xc]={1,0,0,1,1,1,0},
	[0xd]={0,1,1,1,1,0,1},
	[0xe]={1,0,0,1,1,1,1},
	[0xf]={1,0,0,0,1,1,1}
}

--wire start
ws={x=6*8-2,y=2}

--spacing between wires
--out of the encoder
sp1=4

--x of the first resistor
x_res=5*8+3
y_res_top=6*8
y_res_bot=7*8
--spacing between wires
--through the resistors
sp2=8

x_ad=64-1
y_a=11*8-3
x_bc=9*8+3
y_bf=12*8
y_ce=14*8-2
y_d=15*8+3
x_ef=7*8-3
y_g=13*8-1

x_bin=8
y_bin=12*8-3
x_encoder=4*8+1
y_encoder=3
bin_wires={
	--bit 0
 {
		{nil,x_bin+3*sp1,y_bin},
		{1,x_bin+3*sp1,y_encoder+3*sp2},
		{1,x_encoder,y_encoder+3*sp2},
	},
	--bit 1
	{
		{nil,x_bin+2*sp1,y_bin},
		{1,x_bin+2*sp1,y_encoder+2*sp2},
		{1,x_encoder,y_encoder+2*sp2},
	},
	--bit 2
	{
		{nil,x_bin+sp1,y_bin},
		{1,x_bin+sp1,y_encoder+1*sp2},
		{1,x_encoder,y_encoder+1*sp2},
	},
	--bit 3
	{
		{nil,x_bin,y_bin},
		{1,x_bin,y_encoder},
		{1,x_encoder,y_encoder},
	},
}

--wires from the encoder to
--the 7-segment display
to_segments={
 --wire to segment a
	{
		{nil,ws.x,ws.y},
		{1,ws.x+4*sp1,ws.y},
		{0,ws.x+4*sp1,ws.y+4*sp1},
		{1,ws.x+4*sp1,y_res_top-sp1},
		{1,x_res+3*sp2,y_res_top-sp1},
		{1,x_res+3*sp2,y_res_top},
		--bottom
		{nil,x_res+3*sp2,y_res_bot},
		{1,x_res+3*sp2,y_a-sp1},
		{1,x_ad,y_a-sp1},
		{1,x_ad,y_a},
	},
	--wire to segment b
	{
		{nil,ws.x,ws.y+sp1},
		{1,ws.x+5*sp1,ws.y+sp1},
		{0,ws.x+5*sp1,ws.y+4*sp1},
		{
			1,
			ws.x+5*sp1,
			y_res_top-2*sp1,
		},
		{
			1,
			x_res+4*sp2,
			y_res_top-2*sp1
		},
		{1,x_res+4*sp2,y_res_top},
		--bottom
		{nil,x_res+4*sp2,y_res_bot},
		{1,x_res+4*sp2,y_bf}
	},
	--wire to segment c
	{
		{nil,ws.x,ws.y+2*sp1},
		{1,ws.x+6*sp1,ws.y+2*sp1},
		{0,ws.x+6*sp1,ws.y+4*sp1},
		{1,ws.x+6*sp1,y_res_top-3*sp1},
		{1,x_res+5*sp2,y_res_top-3*sp1},
		{1,x_res+5*sp2,y_res_top},
		--bottom
		{nil,x_res+5*sp2,y_res_bot},
		{1,x_res+5*sp2,y_ce},
		{1,x_bc,y_ce},
	},
	--wire to segment d
	{
		{nil,ws.x,ws.y+3*sp1},
		{1,ws.x+7*sp1,ws.y+3*sp1},
		{1,ws.x+7*sp1,ws.y+4*sp1},
		{1,ws.x+7*sp1,y_res_top-4*sp1},
		{1,x_res+6*sp2,y_res_top-4*sp1},
		{1,x_res+6*sp2,y_res_top},
		--bottom
		{nil,x_res+6*sp2,y_res_bot},
		{1,x_res+6*sp2,y_d+2},
		{1,x_ad,y_d+2},
		{1,x_ad,y_d},
	},
	--wire to segment e
	{
		{nil,ws.x,ws.y+4*sp1},
		{1,ws.x+1*sp1,ws.y+4*sp1},
		{0,ws.x+1*sp1,ws.y+7*sp1},
		{
			1,
			ws.x+1*sp1,y_res_top-2*sp1
		},
		{1,x_res,y_res_top-2*sp1},
		{1,x_res,y_res_top},
		--bottom
		{nil,x_res,y_res_bot},
		{1,x_res,y_a-3*sp1},
		{1,x_ef-3*sp1,y_a-3*sp1},
		{1,x_ef-3*sp1,y_ce},
		{1,x_ef,y_ce},
	},
	--wire to segment f
	{
		{nil,ws.x,ws.y+5*sp1},
		{1,ws.x+3*sp1,ws.y+5*sp1},
		{1,ws.x+3*sp1,ws.y+7*sp1},
		{1,ws.x+3*sp1,y_res_top-sp1},
		{1,x_res+2*sp2,y_res_top-sp1},
		{1,x_res+2*sp2,y_res_top},
		--bottom
		{nil,x_res+2*sp2,y_res_bot},
		{1,x_res+2*sp2,y_a-sp1},
		{1,x_ef-4,y_a-sp1},
		{1,x_ef-4,y_bf},
		{1,x_ef,y_bf},
	},
	--wire to segment g
	{
		{nil,ws.x,ws.y+6*sp1},
		{1,ws.x+2*sp1,ws.y+6*sp1},
		{1,ws.x+2*sp1,ws.y+7*sp1},
		{1,ws.x+2*sp1,y_res_top-sp1},
		{1,x_res+sp2,y_res_top-sp1},
		{1,x_res+sp2,y_res_top},
		--bottom
		{nil,x_res+sp2,y_res_bot},
		{1,x_res+1*sp2,y_a-2*sp1},
		{1,x_ef-2*sp1,y_a-2*sp1},
		{1,x_ef-2*sp1,y_g},
		{1,x_ef,y_g}
	},
}




function wire_color(bit)
	if bit==1 then
		return 10
	end
	
	return 6
end

function draw_wire(w,c)
	local over,x1,y1,x2,y2=unpack(w)
	if over>0 then
		-- wire is on top of the
		-- circuit board so just
		-- draw a line
		line(x1,y1,x2,y2,c)
	else
	 -- draw a pair of dots to
	 -- show where the wire is
	 -- on the other side of the
	 -- circuit board
		circfill(x1,y1,r_wire,c)
		circfill(x2,y2,r_wire,c)
	end
end

function draw_wire_poly(w,c)
	local prev={x=0,y=0}
	for seg in all(w) do
		local over,x,y=unpack(seg)

		-- over=nil means moveto
		-- over=0,1 means draw wire
		if over!=nil then
			draw_wire(
				{over,prev.x,prev.y,x,y}, 
				c
			)
		end
		
		--always update the previous
		prev.x=x
		prev.y=y
	end
end

-- draw wires from encoder
-- to 7-segment display
function draw_segment_wires(n)

	local segments=lcd_encoder[n]
	for i=1,7 do
		c=wire_color(segments[i])
		draw_wire_poly(
			to_segments[i],c)
	end
end

function draw_binary_wires(n)
	local bits=to_bits(n)
	for i=1,4 do
		c=wire_color(bits[i])
		draw_wire_poly(
			bin_wires[i],c)
	end
end
