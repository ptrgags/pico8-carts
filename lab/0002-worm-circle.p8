pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- worm circle
-- by peter gagliardi (@ptrgags)
-- 2026-07

--[[
fun with pattern fills!
 
some experiments built on
top of davemakes' (@mixolumia)
first pico-8 tutorial of
a moving circle. see:

https://youtu.be/mh9-iriwhhk

for the original context.

i noticed the pic0-8 cheatsheet
in the video went deeper than
the cheatsheet i've seen in
the past. that's how i found
out about pattern fills! 
(fillp()). see

help fillp()

and

https://pico-8.fandom.com/wiki/fillp

for more info.
--]]


--[[
lookup table for "worm"
animated pattern fill
 
fillp() uses bit flags to
encode a 4x4 pixel pattern
in binary, the flags are 
encoded in row-major order
(i.e. row-by-row like this):
 
abcd
efgh --> abcdefghijklmnop
ijkl
mnop
 
here i'm setting up a
table of several patterns
that animate a line moving
around a square for the
"worms"
--]]
pat_animated={
  --[[
  frame 1
  1110
  0000
  0000
  0000
  --]]
  --[[
  note: the 0b prefix means
  this is a binary number!
  --]]
  0b1110000000000000,
  --[[
  frame 2
  1000
  1000
  1000
  0000
  --]]
  0b1000100010000000,
  --[[
  frame 3
  0000
  0000
  1000
  1100
  --]]
  0b0000000010001100,
  --[[
  frame 4
  0000 this one could be
  0000 written 0b111, but
  0000 here i'd rather be
  0111 consistent.
  --]]
  0b0000000000000111,
  --[[
  frame 5
  0000
  0001
  0001
  0001
  --]]
  0b0000000100010001,
  --[[
  frame 6
  0011
  0001
  0000
  0000
  --]]
  0b0011000100000000
  --and here we loop back
  --to the start
}

function _init()
 --circle position, radius
 --and movement speed
 --(see video)
 x=64
 y=64
 r=12
 speed=2
 
 --[[
 i'm using pattern fills so
 let's set two colors!
 
 a color in hexadecimal 0xpq
 means the 1 bits in the
 pattern will use color p
 and the 0 bits will use
 color q.
 
 in this case we have 0x12
 so 1 bit = color 0x1 (navy)
    0 bit = color 0x2 (maroon)
 --]]
 c_bg=0x12
 
 --[[
 the animated pattern in
 the circle is worms digging
 in the dirt, so use
 pink(14=0xe in hexadecimal) 
 on brown(0x4)
 --]]
 c_worm=0xe4

end

function _update60()
 --[[movement
 instead of the button numbers,
 you can use shift+(u|d|l|r)
 to select a d-pad button!
 
 e.g. here shift+l=⬅️
 --]]
	if btn(⬅️) then
	 x=x-speed
	end
	if btn(➡️) then
	 x=x+speed
	end
	if btn(⬆️) then
	 y=y-speed
	end
	if btn(⬇️) then
	 y=y+speed
	end
	
	--[[
	use mid as clamp()
	to keep the circle on the 
	screen
	--]]
	x=mid(x,r,127-r)
	y=mid(y,r,127-r)
	
	--animate a little faster
	anim_t=4 * time()
	--[[
	convert from a decimal
	to an integer in [1, 6].
	this is the frame number 
	for the pattern animation
	
	- flr() rounds the time down
	to an integer
	
	- %6 (modulo 6) makes the
	  number wrap around in the
	  range [0, 6-1=5]
	- the +1 is because pico8/lua
	  indexes tables starting at
	  1 instead of 0. annoying.
	--]]
	pat_frame=flr(anim_t) % 6 + 1
end

function _draw()
 cls()
 
 --[[
 draw the background
 
 nice! there are preset
 patterns (shift+letter)
 in this case, shift+y=▤
 --]]
 fillp(▤)
 rectfill(0,0,127,127,c_bg)
 
 --[[
 draw a circle, but fill it
 with a custom pattern (the
 worm animation)
 
 pat_animated[pat_frame]
 looks up a single value 
 from the table (see top of 
 file) using the index
 (pat_frame) we computed
 in _update60()
 --]]
 fillp(pat_animated[pat_frame])
 circfill(x,y,r,c_worm)
end

