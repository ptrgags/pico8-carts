pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	cur={x=0,y=0}
end

function _update()
	dx=axisp(⬅️,➡️)
	dy=axisp(⬆️,⬇️)
	
	-- restrict motion to
	-- only be along the top and
	-- left of the screen
	if (cur.x>0) dy=0
	if (cur.y>0) dx=0
	
	-- move cursor and restrict
	-- to screen bounds
	cur.x+=dx
	cur.y+=dy
	cur.x=mid(cur.x,0,15)
	cur.y=mid(cur.y,0,15)
	
	if btnp(❎) then
		old=mget(cur.x,cur.y)
		if old==16 then
			mset(cur.x,cur.y,17)
		elseif old==17 then
		 mset(cur.x,cur.y,16)
		end
	end
	
end

function _draw()
	cls()
	pal()
	map()
	
	-- columns of stitches
	for i=1,15 do
		stitch_col(i)	
	end
	
	-- rows of stitches
	for i=1,15 do
		stitch_row(i)
	end
	
	-- cursor
	spr(18,cur.x*8,cur.y*8)

 pal(7,12)
 if cur.x>0 then
 	stitch_col(cur.x)
 elseif cur.y>0 then
  stitch_row(cur.y)
 end
end


-->8
--utility functions

-- i find the and/or idiom
-- confusing, so let's make
-- a select function. this is
-- like select() in wgsl
-- see https://www.w3.org/tr/wgsl/#select-builtin
function sel(a,b,x)
 return x and a or b
end

-- special case: convert
-- boolean to a number
function to_num(x)
 return x and 0 or 1
end

-- turn two btnp() into an
-- "axis" that returns a value
-- in {-1,0,1}
function axisp(b1,b2)
	if (btnp(b1)) return -1
	if (btnp(b2)) return 1
	return 0
end
-->8
-- rendering stitches

function stitch_col(i)
	local col_bit=to_num(
		fget(mget(i,0),0)
	)
		
	for j=1,15 do
	 local s=sel(3,4,j%2==col_bit)
	 spr(s,8*i,8*j)
	end
end

function stitch_row(i)
 local row_bit=to_num(
 	fget(mget(0,i),0)
 )
 
 for j=1,15 do
 	local s=sel(1,2,j%2==row_bit)
 	spr(s,8*j,8*i)
 end
end
