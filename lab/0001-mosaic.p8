pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- offset for one row in the
-- sprite sheet
d_row = 16

spr_cur=d_row

-- top left corner of tiles
-- 1x1, 2x2, 4x4 respectively
-- the 1x1 tile is a single
-- tile, the others are 3x3.
--
-- each sprite has 2 flags
-- pointing the direction to
-- the top left corner
--
-- 0 - up
-- 1 - left
spr_small=1
spr_med=2
spr_large=5

flag_up=0
flag_left=1

function _init()
 frame = 0
 -- cursor is a reserved word
 cur = {x=0,y=0}
end

function _draw()
 cls()
 pal()
 
 -- draw the tiles
 map(0, 0, 0, 0, 16, 16)
 
 -- draw the cursor
 -- toggle between dark grey
 -- and yellow
 local colors = {5, 10}
 local cur_color = (frame \ 16) % 2 + 1
 pal(5, colors[cur_color])
 spr(spr_cur, 8 * cur.x, 8 * cur.y)
end

-- find what tile sizes fit
function check_fit(x, y)
	local bound=5
	
 for dx=0,3 do
  for dy=0,3 do
   -- if there's a tile here
   -- update the size bound
   local val = mget(
    x + dx,
    y + dy
   )
   if val != 0 then
    bound = min(
     bound,
     max(dx, dy)
    )
   end
  end
 end
 
 -- check which sizes fit
 local sizes = {1, 2, 4}
 if (bound <= 4) deli(sizes)
 if (bound <= 2) deli(sizes)
 return sizes
end

function fill_med(x, y)
 -- 4 corner tiles
 for i=0,1 do
  for j=0,1 do
   mset(
    x + i,
    y + j, 
    -- stride of 2 because
    -- the spritesheet is
    -- 3x3 not 2x2
    spr_med + 
     2 * (j * d_row + i)
   )
  end
 end
end

function fill_large(x, y)
 for i=0,3 do
  for j=0,3 do
   
   -- the sprite map has
   -- 3x3 tiles, so 
   -- map 0, 1, 2, 3 to
   -- 0, 1, 1, 2 for each
   -- direction to repeat
   -- the middle section
  	local row_offset = (
  	 i >> 1 + i & 1
  	)
  	local col_offset = (
  	 j >> 1 + j & 1
  	)
  
   mset(
   	x + i,
   	y + j,
   	(
   	 spr_large + 
     row_offset * d_row +
     col_offset
    )
   )
  end
 end
end

function fill_tile(x, y, size)
 if size == 1 then
  mset(x, y, spr_small)
 elseif size == 2 then
  fill_med(x, y)
 else
  fill_large(x, y)
 end
end

-- add a random tile of size
-- 1, 2, or 4 as long as it
-- fits
function add_rand_tile(x, y)
 local sizes = check_fit(x, y)
 local tile_size = rnd(sizes)
 fill_tile(x, y, tile_size)
end

-- look for an empty place in
-- the map and add a tile there
function seek_add_tile()
 -- scan over the map from 
 -- top to bottom
 for i=0,255 do
  y = i \ 16
  x = i % 16
  
  -- if the tile is empty,
  -- add a tile and stop
 	local val = mget(x, y)
 	if val == 0 then
 	 add_rand_tile(x, y)
 		return 
 	end
 end
end

function reject_tile()
  local x = cur.x
  local y = cur.y
  
  local val = mget(x, y)
  if (val == 0) return
  
  -- play "reject tile" sound
  sfx(0)
  
  -- follow the path (denoted
  -- by the sprite flags) up
  -- to the top left corner
  -- of the tile
  local flags
  local left
  local right
  repeat
  	flags = fget(mget(x, y))
 	 left = flags & flag_left
 	 up = flags & flag_up
 	 if (left != 0) x -= 1
 	 if (up != 0) y -= 1
  until flags == 0
  
  val = mget(x, y)
  local size = 1
  if val == spr_large then
   size = 4
  elseif val == spr_med then
   size = 2
  end
  
  for i=0,size-1 do
  	for j=0,size-1 do
  	 mset(x + i, y + j, 0)
  	end
  end
end

function _update()
 if frame % 10 == 0 then
  seek_add_tile()
 end
 
 -- move the cursor around
 if (btnp(⬅️)) cur.x -= 1
 if (btnp(➡️)) cur.x += 1
 if (btnp(⬆️)) cur.y -= 1
 if (btnp(⬇️)) cur.y += 1
 
 -- clamp to boundary
 cur.x = mid(0, cur.x, 15)
 cur.y = mid(0, cur.y, 15)
 
 if (btnp(❎)) reject_tile()
 
 frame += 1
end
