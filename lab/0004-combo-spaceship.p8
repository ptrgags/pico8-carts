pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- combo spaceship 
-- by peter gagliardi @ptrgags
-- 2026-07

function _init()
 --[[
 palt() sets which colors
 are transparent in sprites.
 but my counter stores the
 opposite, which colors
 are visible.
 --]]
 visible=1
 palt(~visible)
 
 x=64
 y=64
end

function _update()
	if btnp(⬆️) then
	 visible+=1
	 palt(~visible)
 elseif btnp(⬇️) then
  visible-=1
 	palt(~visible)
 end
 
 x=64+32*sin(0.25*t())
 y=64+32*cos(0.125*t())
end

function _draw()
 cls()
	spr(1,x-16,y-16,4,4)
	
	print("⬆️/⬇️ - cycle spaceship",0,0,12)
	
end
