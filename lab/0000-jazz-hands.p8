pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- jazz hands
-- by peter gagliardi (@ptrgags)
-- 2021

x = 8
y = 8

function play_cell()
 tile = mget(x, y)
 for i=0,7 do
  if fget(tile, i) then
   sfx(i)
  end
 end
end

function _update()
 if btnp(⬆️) then
 	y -= 1
 	play_cell()
 end
 if btnp(⬇️) then
  y += 1
  play_cell()
 end
 if btnp(⬅️) then
 	x -= 1
 	play_cell()
 end
 if btnp(➡️) then
  x += 1
  play_cell()
 end
 
 x = max(0, x)
 x = min(x, 15)
 y = max(0, y)
 y = min(y, 15)
end

function _draw()
	cls()
	map(0,0,0,0,16,16)
	spr(0,8*x,8*y)
end
