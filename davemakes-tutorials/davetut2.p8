pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 stars={}
 
 for i=1,100 do
 	add(stars,make_star())
 end
 
 ship={
 	x=64,
 	y=110,
 	speed=2,
 }
 
 bullets={}
end

function _update()
	for s in all(stars) do
	 s.y+=s.speed
	 s.y%=128
	end
	
	for b in all(bullets) do
		b.y-=b.speed
		b.life-=1
		if b.life<=0 then
			del(bullets,b)
		end
	end
	
	if(btn(⬅️)) ship.x-=ship.speed
	if(btn(➡️)) ship.x+=ship.speed
	
	ship.x=mid(ship.x,4,128-4)
	
	if btnp(❎) then
		add(
			bullets,make_bullet(ship.x,ship.y-4))
	end
	
end

function _draw()
	cls()
	
	for star in all(stars) do
		pset(star.x,star.y,star.c)
	end 
	
	for b in all(bullets) do
		spr(2,b.x-4,b.y)
	end
	
	spr(1,ship.x-4,ship.y-4)
end
-->8
--stars
function make_star()
  return {
   x=rnd(128),
   y=rnd(128),
   c=rnd({7,6,1,13}),
   speed=rnd(1)+1,
  }
end
-->8
--bullets
function make_bullet(x,y)
	return {
	  x=x,
	  y=y,
	  speed=3,
	  life=60,
	}
end
